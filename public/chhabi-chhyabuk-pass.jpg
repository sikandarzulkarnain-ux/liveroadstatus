    .sticky-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 6px 4px; /* Reduced padding */
        border-radius: 4px;
        text-decoration: none !important;
        color: #fff !important;
        font-size: 11px; /* Smaller font */
