    }

    .sticky-btn:active {
        transform: scale(0.95);
    }
    
    /* Desktop styles */
    @media (min-width: 768px) {
        .mobile-sticky-footer {
            display: none !important;
        }
        #scroll-top {
            bottom: 20px;
        }
    }

    /* Mobile display trigger */
