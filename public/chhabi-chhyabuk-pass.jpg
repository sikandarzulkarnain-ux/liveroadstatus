        <script>
        $("#con").on("change", function() {
            value = this.value;
            // call ajax
            $("#act").empty();
            $.ajax({
                url: "https://www.adventuregreathimalaya.com/wp-admin/admin-ajax.php",
                type: 'POST',
                data: 'action=my_special_ajax_call&conid=' + value,
                success: function(results) {
                    $("#activity_ajax").html(results);
                }
            });

        });

        function formChecksearch(frm) {
            if (frm.con.value == false) {
                alert("Destination is required.");
                frm.con.focus();
                return false;
            }
            if (frm.act.value == false) {
                alert("Activity is required.");
                frm.act.focus();
                return false;

            }
            if (frm.dur.value == false) {
                alert("Duration is Required.");
                frm.dur.focus();
                return false;
            }
        }
        </script>

        
